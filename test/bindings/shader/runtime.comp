#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler2D images[];
layout(set=0,binding=1,std430) buffer Output { vec4 color; } result;
void main() { result.color = texture(images[nonuniformEXT(gl_GlobalInvocationID.x)], vec2(0)); }
